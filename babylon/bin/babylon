#!/usr/bin/env bash
# babylon's CLI: each command is one stateless MCP tools/call to the server on BABYLON_URL.
set -euo pipefail

url=${BABYLON_URL:-http://127.0.0.1:${BABYLON_PORT:-4050}/}
version=2026-07-28

usage() {
  cat >&2 <<'USAGE'
usage: babylon file TITLE [--repo R] [--body B] [--priority low|med|high] [--epic N] [--blocked-by N,N]
       babylon list [--repo R] [--status S,S] [--mine]
       babylon show N
       babylon claim N
       babylon release N
       babylon submit N
       babylon answer ASK CHOICE
       babylon update N [--title T] [--body B] [--repo R] [--status S] [--priority P]
       babylon new [--repo R]           (title, repo and body in $EDITOR)
       babylon edit N                   (its title, repo and body in $EDITOR)
       babylon move N up|down [--repo R]
       babylon link FROM blocks|relates|duplicates|parent TO
       babylon unlink FROM KIND TO
       babylon call TOOL JSON
A ticket's repo defaults to the git repository you are in. A claim is held by this tmux pane.
USAGE
  exit 2
}

call() {
  local tool=$1 args=$2 body response
  body=$(jq -nc --arg tool "$tool" --argjson args "$args" --arg v "$version" \
    '{jsonrpc: "2.0", id: 1, method: "tools/call",
      params: {name: $tool, arguments: $args,
               _meta: {"io.modelcontextprotocol/protocolVersion": $v,
                       "io.modelcontextprotocol/clientCapabilities": {}}}}')
  response=$(curl -sS --fail-with-body "$url" \
    -H 'content-type: application/json' -H 'accept: application/json, text/event-stream' \
    -H "mcp-protocol-version: $version" -H 'mcp-method: tools/call' -H "mcp-name: $tool" \
    -H "x-babylon-pane: ${TMUX_PANE:-}" \
    --data-binary "$body") || { echo "babylon: no server at $url" >&2; exit 1; }
  if jq -e '.error' <<<"$response" >/dev/null; then
    jq -r '"babylon: " + .error.message' <<<"$response" >&2
    exit 1
  fi
  if jq -e '.result.isError == true' <<<"$response" >/dev/null; then
    jq -r '"babylon: " + .result.content[0].text' <<<"$response" >&2
    exit 1
  fi
  jq -r '.result.content[0].text' <<<"$response"
}

# --flag value pairs into a JSON object; --blocked-by and --status take comma lists
flags() {
  local json='{}' key value
  while (($#)); do
    if [[ $1 == --mine ]]; then
      json=$(jq -c '. + {mine: true}' <<<"$json"); shift; continue
    fi
    [[ $1 == --* && $# -ge 2 ]] || usage
    key=${1#--}; key=${key//-/_}; value=$2; shift 2
    case $key in
      epic) json=$(jq -c --argjson v "$value" '. + {epic_id: $v}' <<<"$json") ;;
      blocked_by) json=$(jq -c --arg v "$value" '. + {blocked_by: ($v | split(",") | map(tonumber))}' <<<"$json") ;;
      status) json=$(jq -c --arg v "$value" '. + {status: ($v | split(","))}' <<<"$json") ;;
      title | body | repo | priority) json=$(jq -c --arg k "$key" --arg v "$value" '. + {($k): $v}' <<<"$json") ;;
      *) usage ;;
    esac
  done
  printf '%s' "$json"
}

# A ticket as text in $EDITOR: its title on the first line, `repo: R` on the second, then a blank
# line and its body. Sets title, repo and body; false when the title is left empty.
compose() {
  "${EDITOR:-vi}" "$1" || return 1
  title=$(sed -n 1p "$1")
  repo=$(sed -n 's/^repo: *//p' "$1" | head -1)
  body=$(sed 1,2d "$1" | sed '/[^[:space:]]/,$!d')
  [[ -n ${title//[[:space:]]/} ]]
}

# the fields compose read, as JSON, a repo left empty left out
fields() {
  jq -nc --arg t "$title" --arg r "$repo" --arg b "$body" '{title: $t, body: $b} + if $r == "" then {} else {repo: $r} end'
}

lines() { jq -r '.[] | "#\(.id)\t\(.status)\t\(.priority)\t\(.repo // "-")\t\(.claimed_by // "")\t\(.title)"'; }

(($#)) || usage
command=$1; shift

case $command in
  file)
    (($#)) || usage
    title=$1; shift
    args=$(flags "$@")
    if ! jq -e 'has("repo")' <<<"$args" >/dev/null && top=$(git rev-parse --show-toplevel 2>/dev/null); then
      args=$(jq -c --arg r "$(basename "$top")" '. + {repo: $r}' <<<"$args")
    fi
    call file_ticket "$(jq -c --arg t "$title" '. + {title: $t}' <<<"$args")" | jq -r '"#\(.id) \(.title)"'
    ;;
  new)
    repo=
    case $# in 0) ;; 2) [[ $1 == --repo ]] || usage; repo=$2 ;; *) usage ;; esac
    draft=$(mktemp); trap 'rm -f "$draft"' EXIT
    printf '\nrepo: %s\n\n' "$repo" >"$draft"
    compose "$draft" || { echo "babylon: no title, nothing filed" >&2; exit 1; }
    call file_ticket "$(fields)" | jq -r '"#\(.id) \(.title)"'
    ;;
  edit)
    (($# == 1)) || usage
    draft=$(mktemp); trap 'rm -f "$draft"' EXIT
    call get_ticket "{\"id\": $1}" | jq -r '"\(.title)\nrepo: \(.repo // "")\n\n\(.body // "")"' >"$draft"
    compose "$draft" || { echo "babylon: no title, #$1 left as it was" >&2; exit 1; }
    call update_ticket "$(fields | jq -c --argjson id "$1" '. + {id: $id}')" | jq -r '"#\(.id) \(.title)"'
    ;;
  move)
    (($# == 2 || $# == 4)) && [[ $2 == up || $2 == down ]] || usage
    args=$(jq -nc --argjson id "$1" --arg by "$2" '{id: $id, by: $by}')
    if (($# == 4)); then
      [[ $3 == --repo ]] || usage
      args=$(jq -c --arg r "$4" '. + {repo: $r}' <<<"$args")
    fi
    call move_ticket "$args" | jq -r '"#\(.id) \(.title)"'
    ;;
  list) call list_tickets "$(flags "$@")" | lines ;;
  show) (($# == 1)) || usage; call get_ticket "{\"id\": $1}" | jq . ;;
  update)
    (($#)) || usage
    id=$1; shift
    args=$(flags "$@" | jq -c 'if .status then .status |= .[0] else . end')
    call update_ticket "$(jq -c --argjson id "$id" '. + {id: $id}' <<<"$args")" |
      jq -r '"#\(.id) \(.status) \(.title)"'
    ;;
  claim)
    (($# == 1)) || usage
    call claim_ticket "{\"id\": $1}" | jq -r '"#\(.id) \(.title)\nbranch \(.branch)\nstart  \(.start)"'
    ;;
  release) (($# == 1)) || usage; call release_ticket "{\"id\": $1}" | jq -r '"#\(.id) \(.status) \(.title)"' ;;
  answer) (($# == 2)) || usage; call answer_ask "{\"id\": $1, \"choice\": $2}" | jq -r '"ask #\(.id): \(.answer)"' ;;
  submit) (($# == 1)) || usage; call submit_ticket "{\"id\": $1}" | jq -r '"#\(.id) \(.stage) \(.title)"' ;;
  link | unlink)
    (($# == 3)) || usage
    call "${command}_tickets" "{\"from\": $1, \"kind\": \"$2\", \"to\": $3}" | jq -c .
    ;;
  call) (($# == 2)) || usage; call "$1" "$2" ;;
  *) usage ;;
esac
